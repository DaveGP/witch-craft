  m_Name: ember
  m_EditorClassIdentifier: Assembly-CSharp::Data.ScriptableObjects.CompanionDefinition
  Id: ember
  DisplayName: Ember
  Species: Fox Spirit
  Color: {r: 1, g: 0.55, b: 0.25, a: 1}
  Prefab: {fileID: 949660837117588396, guid: a0f5c0816080a4e8d8ec5bd55f498a0e, type: 3}
  Nocturnal: 0
  Greeting: '"...You can see me? Most people only see a flicker. I am Ember."'
  Plea: '"It''s so dark down here. If you brought me a Glimmer Draught, I think I
    could find my way out."'
  RecruitGift:
    Item: {fileID: 11400000, guid: 847b9d9fb9a224a59acd6e2cdf4182de, type: 2}
    Amount: 1
  MoveInLine: '"It''s so bright! Thank you, witch. I will keep your hearth warm,
    always."'
  ChatLines:
  - '"Your hearth is the cosiest fire I''ve ever slept beside."'
  - '"When you''re out late, {name}, I keep the fire bright so you can find your
    way back."'
  - '"Crystals hum if you listen closely. These ones hum in B flat."'
  - '"Pip asked if I was a very orange dog. I have decided to allow it."'
  LikedGifts:
  - {fileID: 11400000, guid: 48ca9d15d44c84b179673120ad807a6e, type: 2}
  - {fileID: 11400000, guid: 3722690083b8c470183bd59a4377530c, type: 2}
  - {fileID: 11400000, guid: 847b9d9fb9a224a59acd6e2cdf4182de, type: 2}
  FavouriteFurniture: {fileID: 11400000, guid: 219c417a894a64b9db9eb7e6615ccefe, type: 2}
  Rewards:
  - Friendship: 6
    Recipe: {fileID: 0}
    Glyph: {fileID: 0}
    Line: '"I will tell you a secret, friend: light and life together make a little
      friend of their own. Lux and Vita."'
