%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 079bcd380567145bc84a30791440eb72, type: 3}
  m_Name: bramble
  m_EditorClassIdentifier: Assembly-CSharp::Data.ScriptableObjects.CompanionDefinition
  Id: bramble
  DisplayName: Bramble
  Species: Hedgehog
  Color: {r: 0.62, g: 0.45, b: 0.3, a: 1}
  Prefab: {fileID: 7785332836048652414, guid: 074f56bebec904adfa7ba3328e1f9f27, type: 3}
  Nocturnal: 0
  Greeting: '"Hm? Oh, hullo. Mind the prickles. I''m Bramble. I mostly forage and
    complain about weather. And write. You''ve read my book? Hardly anybody has."'
  Plea: '"Your home has a garden, does it? I might be persuaded. But one thing at
    a time."'
  RecruitGift:
    Item: {fileID: 11400000, guid: f86313d2dc61d49199b20b97715c63c4, type: 2}
    Amount: 4
  MoveInLine: '"Right then. Your home it is. I''ll pack my things. Which is to say,
    I''ll roll there."'
  RevealBook: {fileID: 11400000, guid: 331ef5a1e78fe4291bf7e49deda11e6f, type: 2}
  Whereabouts: in the forest to the north east, by the blocked burrow
  Quests:
  - Objective: Find Bramble's spectacles, in the shade beyond the Old Oak
    Ask: '"I''d sign your copy, but I can''t see the page. I took my spectacles off
      to sniff the mushrooms, somewhere past the far side of the Old Oak, the big
      one, where it''s shady all day. Then I couldn''t see where I''d put them. You
      see the problem."'
    Offer: Give Bramble the spectacles
    Thanks: '"Ah. So that''s what you look like. Hm. And that''s what the forest
      looks like. It''s got much bigger."'
    Needs:
      Item: {fileID: 11400000, guid: 24acc4179e1bd4eef82a4ab3800bc05f, type: 2}
      Amount: 1
    Piece: {fileID: 0}
    Goal: 
  - Objective: Conjure a Woven Rug at home (reeds grow by the pond)
    Ask: '"Now then, this home of yours. Hedgehogs don''t do bare floorboards. Terrible
      on the feet. Conjure a rug, a proper woven one, and I''ll think harder about
      it."'
    Offer: Tell Bramble about the rug
    Thanks: '"A rug! Rose-coloured, you say. Well. I''ve slept on worse. I''ve slept
      on nettles."'
    Needs:
      Item: {fileID: 0}
      Amount: 1
    Piece: {fileID: 11400000, guid: 9d765b636f8d74f29acddf716cfaa329, type: 2}
    Goal: 
  - Objective: Clear the boulder from Bramble's burrow with Levitate (inscribe Aer
      + Forma)
    Ask: '"Trouble is, all my things are down my burrow, and a boulder''s rolled
      across the door. I''m a hedgehog. I can''t shift a boulder. But you''ve a spellbook,
      haven''t you? Put Aer and Forma on a page together and you''ll have Levitate.
      Lift the thing out of my way."'
    Offer: Tell Bramble the door's clear
    Thanks: '"Oh, well done. Look at that. There''s my door. I''d forgotten it was
      green."'
    Needs:
      Item: {fileID: 0}
      Amount: 1
    Piece: {fileID: 0}
    Goal: bramble_burrow
  - Objective: Brew a Leaping Tonic at your bench and bring Bramble one
    Ask: '"Moving house at my age, though. My knees. A Leaping Tonic''s the only
      thing for them, and you''ve the recipe in your book: Spring Water, a ground
      Glowcap, two boils, a Wild Berry to finish. Brew it carefully. A good batch
      makes three, and I only want the one. You''ll be wanting the others."'
    Offer: Give Bramble a Leaping Tonic
    Thanks: '"Mmf. Tastes of pond. Oh, but that''s better. That''s a good deal better."'
    Needs:
      Item: {fileID: 11400000, guid: 59bea374c70534337b136bcc1d51039f, type: 2}
      Amount: 1
    Piece: {fileID: 0}
    Goal: 
  - Objective: Climb the Old Oak and fetch the acorn from its nest (drink a Leaping
      Tonic for the last big gap)
    Ask: '"One last thing. My winter store''s in the nest at the very top of the
      Old Oak. I was a much younger hedgehog when I put it there. Your broom''s no
      good in those branches, you''ll have to climb. There''s a mushroom at the foot
      to get you started. Near the top there''s a gap no witch could jump, so drink
      a tonic before it. Bring me the acorn and I''m yours."'
    Offer: Give Bramble the acorn
    Thanks: '"You went all the way up there! And it''s still good. Probably."'
    Needs:
      Item: {fileID: 11400000, guid: 09a80c646dd764661b8210c8c0ba37c8, type: 2}
      Amount: 1
    Piece: {fileID: 0}
    Goal: 
  Expectant: '"Back already? Well, go on then. What have you got?"'
  ChatLines:
  - '"The lavender in your planters wants more sun. Or less. One of those."'
  - '"Nettles are misunderstood. Like me."'
  - '"Morning, {name}. Or afternoon. I don''t keep track."'
  - '"I heard the owl up in the sky islands keeps recipes in his nest."'
  LikedGifts:
  - {fileID: 11400000, guid: f86313d2dc61d49199b20b97715c63c4, type: 2}
  - {fileID: 11400000, guid: fbf67058018dc4282a9dac590cb3abe2, type: 2}
  - {fileID: 11400000, guid: ee8d597e20f114ce8b04de49fa3a17d8, type: 2}
  FavouriteFurniture: {fileID: 11400000, guid: 9d765b636f8d74f29acddf716cfaa329, type: 2}
  Rewards:
  - Friendship: 5
    Recipe: {fileID: 11400000, guid: 8f5cb1760f350447092e0ab80908f718, type: 2}
    Glyph: {fileID: 0}
    Line: '"Found this page in a hedge. Featherfall Elixir. Moon Dew, two Feather
      Down, ground Lavender, one boil."'
